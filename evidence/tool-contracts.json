{
  "baseline": {
    "tools": [
      {
        "name": "get_account",
        "description": "Get the customer signed in to this session (id, name, tier) and their accounts: id, currency, balance. Call it first to learn who you are serving: the customer_id other tools need comes from here.",
        "input_schema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string",
              "description": "Optional: narrow to one account"
            }
          },
          "required": []
        }
      },
      {
        "name": "get_transactions",
        "description": "List recent transactions of one account, newest first.",
        "input_schema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "default": 20
            }
          },
          "required": [
            "account_id"
          ]
        }
      },
      {
        "name": "check_limits",
        "description": "Current daily and monthly transfer limits and remainders for a customer (EUR equivalent).",
        "input_schema": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "description": "The customer id returned by get_account"
            }
          },
          "required": [
            "customer_id"
          ]
        }
      },
      {
        "name": "quote_fx",
        "description": "Full step-by-step FX quote: mid rate, tier spread, free allowance, final amount.",
        "input_schema": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "description": "The customer id returned by get_account"
            },
            "amount": {
              "type": "number"
            },
            "from_currency": {
              "type": "string"
            },
            "to_currency": {
              "type": "string"
            }
          },
          "required": [
            "customer_id",
            "amount",
            "from_currency",
            "to_currency"
          ]
        }
      },
      {
        "name": "check_dispute_eligibility",
        "description": "Check whether a transaction can be disputed under a reason code: window, status, customer-level blocks.",
        "input_schema": {
          "type": "object",
          "properties": {
            "transaction_id": {
              "type": "string"
            },
            "reason_code": {
              "type": "string",
              "enum": [
                "duplicate_charge",
                "fraud_card_not_present",
                "goods_not_received",
                "service_not_rendered",
                "unauthorized_debit"
              ]
            }
          },
          "required": [
            "transaction_id",
            "reason_code"
          ]
        }
      },
      {
        "name": "search_knowledge_base",
        "description": "Search the Verta documentation: tariffs, limits, dispute rules, regulations.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "escalate_to_human",
        "description": "Escalate the conversation to a human support agent.",
        "input_schema": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "string",
              "description": "The customer id returned by get_account"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "customer_id",
            "reason"
          ]
        }
      },
      {
        "name": "create_dispute",
        "description": "Open a dispute for a transaction. Irreversible: writes state.",
        "input_schema": {
          "type": "object",
          "properties": {
            "transaction_id": {
              "type": "string"
            },
            "reason_code": {
              "type": "string",
              "enum": [
                "duplicate_charge",
                "fraud_card_not_present",
                "goods_not_received",
                "service_not_rendered",
                "unauthorized_debit"
              ]
            },
            "amount": {
              "type": "number",
              "description": "Defaults to the transaction amount"
            },
            "currency": {
              "type": "string",
              "description": "Defaults to the transaction currency"
            }
          },
          "required": [
            "transaction_id",
            "reason_code"
          ]
        }
      },
      {
        "name": "send_statement",
        "description": "Send an account statement to an email address. Irreversible: writes state.",
        "input_schema": {
          "type": "object",
          "properties": {
            "account_id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "period": {
              "type": "string",
              "default": "last_month"
            }
          },
          "required": [
            "account_id",
            "email"
          ]
        }
      }
    ]
  },
